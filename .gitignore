# Python — check.py and install.py are run often enough that this appears on its own.
__pycache__/
*.py[cod]

# Work artifacts: the cross-session, cross-agent handoff channel.
#
# The leading slash matters. It anchors this to the repository root, so `templates/work/`
# — which is the template and MUST stay tracked — is not caught by it.
#
# /work/ is local by default in this repository. Remove this ignore rule or explicitly
# include selected artifacts when they must travel with Git. Transfer options are documented
# in templates/work/README.md under "Transfer and storage".
/work/

