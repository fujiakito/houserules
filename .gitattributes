# Normalize line endings to LF, in the repository and in every working tree.
# Without this, core.autocrlf checks these files out as CRLF on Windows, and a
# contributor on another platform then sees the entire tree as modified.
* text=auto eol=lf

# Frozen evaluation inputs: preserve exact bytes referenced by SHA-256 records.
tests/workflows/prior-art/baseline-prompt.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/workflows/prior-art/candidate-prompt.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/workflows/prior-art/rubric.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/workflows/prior-art/v2/baseline-prompt.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/workflows/prior-art/v2/candidate-prompt.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol
tests/workflows/prior-art/v2/rubric.md -text whitespace=blank-at-eol,-blank-at-eof,space-before-tab,cr-at-eol

# Captured execution evidence: preserve exact bytes, including the CRLF the frozen
# v2 rubric contributes to the grader prompt. Recorded by SHA-256 in the attempt record.
tests/workflows/prior-art/v2/attempt-20260916-outputs/** -text

